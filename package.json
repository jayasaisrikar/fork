{
  "name": "fork",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev:web": "pnpm --filter @fork/web dev",
    "dev:engine": "pnpm --filter @fork/engine dev",
    "dev:treasury": "pnpm --filter @fork/treasury-mcp dev",
    "dev:payments": "pnpm --filter @fork/payments-mcp dev",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
