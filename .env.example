# Copy to .env and fill in. Never commit .env.

# --- ArmorIQ (platform.armoriq.ai) ---
# API key generated on the platform. Required by the engine and the spike scripts.
ARMORIQ_API_KEY=
# ID of the agent registered as "fork-executor" on the platform.
ARMORIQ_AGENT_ID=
# Your ArmorIQ user ID (whether the TS client needs this is spike question U1).
ARMORIQ_USER_ID=
# Email attached to every invoke call; shown as "signed by" on receipts.
DEMO_CFO_EMAIL=

# --- LLM (any OpenAI-compatible endpoint) ---
# e.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_STRATEGIST=
LLM_MODEL_EXECUTOR=

# --- Stripe (test mode only; must start with sk_test_) ---
STRIPE_SECRET_KEY=

# --- MCP servers ---
# Shared secret both MCP servers require in the X-Fork-Secret header.
# Generate with: openssl rand -hex 32
FORK_MCP_SECRET=
TREASURY_MCP_PORT=8787
PAYMENTS_MCP_PORT=8788
# Public HTTPS URLs registered in ArmorIQ's MCP Registry (tunnel or deployed host).
# The engine never calls these; they are here for the spike scripts' output and for docs.
TREASURY_MCP_URL=
PAYMENTS_MCP_URL=

# --- Engine ---
ENGINE_PORT=8790
# Header secret guarding POST /api/reset.
RESET_SECRET=
DATABASE_PATH=./fork.db

# --- Web ---
NEXT_PUBLIC_ENGINE_URL=http://localhost:8790
