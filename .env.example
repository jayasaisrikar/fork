# copy to .env, never commit it

# ArmorIQ (platform.armoriq.ai)
ARMORIQ_API_KEY=
ARMORIQ_AGENT_ID=
ARMORIQ_USER_ID=
RUN_ARMORIQ_LIVE_TESTS=
# identity the agent uses to ask for approval on held payments. must differ from the approver.
ARMORIQ_REQUESTER_EMAIL=fork-agent@kettleandpine.test

# demo CFO, also the email sent with every ArmorIQ call
CFO_EMAIL=
CFO_PASSWORD=
# 1 shows "Continue as guest" on the sign-in form, which signs in as the CFO above. for reviewers.
FORK_GUEST_ACCESS=

# any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_PLANNER=
LLM_MODEL_INBOX=
# tests and rehearsals only: 1 makes the planner return the reference branches, labeled as fixtures
FORK_FIXTURE_PLANNER=

# finance MCP. generate both secrets with: openssl rand -hex 32
# only if the MCP is registered on ArmorIQ under a name other than fork-finance-mcp
# FORK_MCP_NAME=
FORK_MCP_KEY=
MCP_CAPABILITY_SECRET=
FINANCE_MCP_PORT=8797

# engine
ENGINE_PORT=8790
DATABASE_PATH=./fork.db
DEMO_ADMIN_KEY=
# how long a held payment waits for approval on the ArmorIQ platform
HOLD_TIMEOUT_MS=180000
WEB_ORIGIN=http://localhost:3000

# web
NEXT_PUBLIC_ENGINE_URL=http://localhost:8790
# hosted web only: the engine's public URL. the web app then proxies /api to it.
ENGINE_PROXY_URL=
# shown as the GitHub link on the landing page once the repo is public
NEXT_PUBLIC_REPO_URL=

# public /proof page: seconds between probes, and probes per UTC day
PROOF_COOLDOWN_SECONDS=20
PROOF_DAILY_LIMIT=200
# one visitor's probes per hour, counted only for callers the web app's proxy identified
PROOF_CLIENT_HOURLY_LIMIT=10
# shared by the engine and the web app (set the same value on both). with it set, the engine takes
# probes only through the web app, which stamps each one with the visitor's address.
# openssl rand -hex 24
PROOF_EDGE_KEY=
